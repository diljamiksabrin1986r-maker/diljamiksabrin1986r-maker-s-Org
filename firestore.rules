rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedUser() && request.auth.token.email == 'diljamiksabrin1986r@gmail.com';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isUserActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isOwner() {
      return isBootstrappedOwner() || (isVerifiedUser() && hasUserDoc() && isUserActive() && userRole() == 'owner');
    }

    function isAdmin() {
      return isOwner() || (isVerifiedUser() && hasUserDoc() && isUserActive() && userRole() == 'admin');
    }

    function isCashier() {
      return isAdmin() || (isVerifiedUser() && hasUserDoc() && isUserActive() && userRole() == 'cashier');
    }

    function isRequester() {
      return isAdmin() || (isVerifiedUser() && hasUserDoc() && isUserActive() && userRole() == 'requester');
    }

    function isStaff() {
      return isOwner() || (isVerifiedUser() && hasUserDoc() && isUserActive() && userRole() in ['owner', 'admin', 'cashier', 'requester']);
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'twoFactorEnabled', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'twoFactorEnabled', 'twoFactorSecret', 'active', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['owner', 'admin', 'cashier', 'requester', 'customer']
        && data.twoFactorEnabled is bool
        && data.active is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('twoFactorSecret' in data) || (data.twoFactorSecret is string && data.twoFactorSecret.size() <= 64));
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'twoFactorRequired', 'active', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'name', 'role', 'twoFactorRequired', 'active', 'createdBy', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role in ['owner', 'admin', 'cashier', 'requester']
        && data.twoFactorRequired is bool
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'unit', 'isWeighted', 'isQuickItem', 'retailPrice', 'costPrice', 'stock', 'minStock', 'activeOnline', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'barcode', 'pluCode', 'category', 'unit', 'isWeighted', 'isQuickItem', 'retailPrice', 'costPrice', 'stock', 'minStock', 'expiryDate', 'supplierName', 'imageUrl', 'activeOnline', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.unit in ['шт', 'кг', 'л', 'уп']
        && data.isWeighted is bool
        && data.isQuickItem is bool
        && data.retailPrice is number && data.retailPrice >= 0
        && data.costPrice is number && data.costPrice >= 0
        && data.stock is number && data.stock >= 0
        && data.minStock is number && data.minStock >= 0
        && data.activeOnline is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 64))
        && (!('pluCode' in data) || (data.pluCode is string && data.pluCode.size() <= 16))
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))
        && (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 120))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    function isValidSale(data) {
      return data.keys().hasAll(['id', 'receiptNumber', 'type', 'channel', 'cashierId', 'cashierName', 'items', 'totalAmount', 'costTotal', 'cashAmount', 'cardAmount', 'qrAmount', 'paymentMethod', 'syncedFromOffline', 'createdAt'])
        && data.keys().hasOnly(['id', 'receiptNumber', 'type', 'channel', 'shiftId', 'cashierId', 'cashierName', 'items', 'totalAmount', 'costTotal', 'cashAmount', 'cardAmount', 'qrAmount', 'paymentMethod', 'syncedFromOffline', 'authorizedBy', 'createdAt'])
        && isValidId(data.id)
        && data.receiptNumber is string && data.receiptNumber.size() >= 1 && data.receiptNumber.size() <= 64
        && data.type in ['sale', 'return']
        && data.channel in ['pos', 'online']
        && data.cashierId is string && data.cashierId.size() >= 1 && data.cashierId.size() <= 128
        && data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 200
        && data.totalAmount is number && data.totalAmount >= 0
        && data.costTotal is number && data.costTotal >= 0
        && data.cashAmount is number && data.cashAmount >= 0
        && data.cardAmount is number && data.cardAmount >= 0
        && data.qrAmount is number && data.qrAmount >= 0
        && data.paymentMethod in ['cash', 'card', 'qr', 'split', 'online']
        && data.syncedFromOffline is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('shiftId' in data) || (data.shiftId is string && data.shiftId.size() <= 128))
        && (!('authorizedBy' in data) || (data.authorizedBy is string && data.authorizedBy.size() <= 120));
    }

    function isValidShift(data) {
      return data.keys().hasAll(['id', 'cashierId', 'cashierName', 'status', 'openingCash', 'cashSalesTotal', 'cardSalesTotal', 'qrSalesTotal', 'returnsTotal', 'cashInTotal', 'cashOutTotal', 'expectedCash', 'movements', 'openedAt'])
        && data.keys().hasOnly(['id', 'cashierId', 'cashierName', 'status', 'openingCash', 'cashSalesTotal', 'cardSalesTotal', 'qrSalesTotal', 'returnsTotal', 'cashInTotal', 'cashOutTotal', 'expectedCash', 'actualCash', 'discrepancy', 'movements', 'openedAt', 'closedAt'])
        && isValidId(data.id)
        && data.cashierId is string && data.cashierId.size() >= 1 && data.cashierId.size() <= 128
        && data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 120
        && data.status in ['open', 'closed']
        && data.openingCash is number && data.openingCash >= 0
        && data.cashSalesTotal is number && data.cashSalesTotal >= 0
        && data.cardSalesTotal is number && data.cardSalesTotal >= 0
        && data.qrSalesTotal is number && data.qrSalesTotal >= 0
        && data.returnsTotal is number && data.returnsTotal >= 0
        && data.cashInTotal is number && data.cashInTotal >= 0
        && data.cashOutTotal is number && data.cashOutTotal >= 0
        && data.expectedCash is number
        && data.movements is list && data.movements.size() <= 200
        && data.openedAt is string && data.openedAt.size() <= 40
        && (!('actualCash' in data) || data.actualCash is number)
        && (!('discrepancy' in data) || data.discrepancy is number)
        && (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 40));
    }

    function isValidWriteOff(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'category', 'quantity', 'unit', 'costValue', 'reason', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'productName', 'category', 'quantity', 'unit', 'costValue', 'reason', 'notes', 'createdBy', 'createdByName', 'createdAt'])
        && isValidId(data.id)
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160
        && data.category is string && data.category.size() <= 80
        && data.quantity is number && data.quantity > 0
        && data.unit is string && data.unit.size() <= 16
        && data.costValue is number && data.costValue >= 0
        && data.reason in ['expired', 'damaged', 'defect', 'shortage']
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'invoiceNumber', 'supplierName', 'items', 'totalCost', 'parsedByAi', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'invoiceNumber', 'supplierName', 'items', 'totalCost', 'parsedByAi', 'createdBy', 'createdByName', 'createdAt'])
        && isValidId(data.id)
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 64
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 200
        && data.totalCost is number && data.totalCost >= 0
        && data.parsedByAi is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidInventoryAudit(data) {
      return data.keys().hasAll(['id', 'category', 'items', 'discrepancyCount', 'discrepancyValue', 'performedBy', 'performedByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'category', 'items', 'discrepancyCount', 'discrepancyValue', 'performedBy', 'performedByName', 'createdAt'])
        && isValidId(data.id)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 300
        && data.discrepancyCount is int && data.discrepancyCount >= 0
        && data.discrepancyValue is number
        && data.performedBy is string && data.performedBy.size() >= 1 && data.performedBy.size() <= 128
        && data.performedByName is string && data.performedByName.size() >= 1 && data.performedByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidPurchaseRequest(data) {
      return data.keys().hasAll(['id', 'requestNumber', 'requesterId', 'requesterName', 'items', 'isAutoGenerated', 'status', 'unreadForRequester', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'requestNumber', 'requesterId', 'requesterName', 'supplierName', 'items', 'isAutoGenerated', 'status', 'comment', 'adminNote', 'unreadForRequester', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.requestNumber is string && data.requestNumber.size() >= 1 && data.requestNumber.size() <= 64
        && data.requesterId is string && data.requesterId.size() >= 1 && data.requesterId.size() <= 128
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.isAutoGenerated is bool
        && data.status in ['new', 'reviewing', 'approved', 'rejected', 'delivered']
        && data.unreadForRequester is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 120))
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 400))
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 400));
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'category', 'amount', 'description', 'expenseDate', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'category', 'amount', 'description', 'expenseDate', 'createdBy', 'createdAt'])
        && isValidId(data.id)
        && data.category in ['Закупка товара', 'Аренда', 'Зарплата', 'Коммунальные', 'Логистика', 'Списания и брак', 'Прочее']
        && data.amount is number && data.amount >= 0
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 240
        && data.expenseDate is string && data.expenseDate.size() >= 4 && data.expenseDate.size() <= 32
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidSecurityLog(data) {
      return data.keys().hasAll(['id', 'action', 'actorId', 'actorName', 'actorRole', 'details', 'amountImpact', 'createdAt'])
        && data.keys().hasOnly(['id', 'action', 'actorId', 'actorName', 'actorRole', 'details', 'amountImpact', 'authorizedBy', 'createdAt'])
        && isValidId(data.id)
        && data.action in ['remove_cart_item', 'cancel_receipt', 'return_sale', 'stock_adjustment', 'price_change', 'cash_out', 'supplier_return']
        && data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 32
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && data.amountImpact is number
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('authorizedBy' in data) || (data.authorizedBy is string && data.authorizedBy.size() <= 120));
    }

    function isValidOnlineOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerId', 'customerName', 'customerPhone', 'deliveryType', 'items', 'totalAmount', 'paymentMethod', 'paymentStatus', 'orderStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderNumber', 'customerId', 'customerName', 'customerPhone', 'deliveryAddress', 'deliveryType', 'items', 'totalAmount', 'paymentMethod', 'paymentStatus', 'paymentProofNote', 'paymentProofImage', 'paymentVerifiedBy', 'paymentVerifiedAt', 'orderStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 64
        && data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 3 && data.customerPhone.size() <= 40
        && data.deliveryType in ['delivery', 'pickup']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentMethod in ['card_online', 'qr_online', 'cash_on_delivery']
        && data.paymentStatus in ['paid', 'pending', 'awaiting_verification', 'rejected']
        && data.orderStatus in ['new', 'packing', 'delivering', 'completed', 'cancelled']
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 240))
        && (!('paymentProofNote' in data) || (data.paymentProofNote is string && data.paymentProofNote.size() <= 200))
        && (!('paymentProofImage' in data) || (data.paymentProofImage is string && data.paymentProofImage.size() <= 250000))
        && (!('paymentVerifiedBy' in data) || (data.paymentVerifiedBy is string && data.paymentVerifiedBy.size() <= 120))
        && (!('paymentVerifiedAt' in data) || (data.paymentVerifiedAt is string && data.paymentVerifiedAt.size() <= 40));
    }

    function isValidPublicStoreSettings(data) {
      return data.keys().hasAll(['id', 'storeName', 'qrMerchantId', 'updatedAt'])
        && data.keys().hasOnly(['id', 'storeName', 'qrMerchantId', 'updatedAt'])
        && data.id == 'public_store'
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.qrMerchantId is string && data.qrMerchantId.size() >= 1 && data.qrMerchantId.size() <= 120
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidPosSecuritySettings(data) {
      return data.keys().hasAll(['id', 'adminPinHash', 'updatedAt'])
        && data.keys().hasOnly(['id', 'adminPinHash', 'updatedAt'])
        && data.id == 'pos_security'
        && data.adminPinHash is string && data.adminPinHash.size() >= 4 && data.adminPinHash.size() <= 128
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidSupplierPayment(data) {
      return data.keys().hasAll(['id', 'supplierName', 'amount', 'paymentMethod', 'paymentDate', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'supplierName', 'invoiceId', 'invoiceNumber', 'amount', 'paymentMethod', 'paymentDate', 'notes', 'createdBy', 'createdByName', 'createdAt'])
        && isValidId(data.id)
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120
        && data.amount is number && data.amount > 0
        && data.paymentMethod in ['cash', 'bank_transfer', 'card']
        && data.paymentDate is string && data.paymentDate.size() >= 4 && data.paymentDate.size() <= 32
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('invoiceId' in data) || (data.invoiceId is string && data.invoiceId.size() <= 128))
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidSupplierReturn(data) {
      return data.keys().hasAll(['id', 'returnNumber', 'supplierName', 'productId', 'productName', 'unit', 'quantity', 'unitCost', 'totalRefund', 'reason', 'settlementType', 'createdBy', 'createdByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'returnNumber', 'supplierName', 'productId', 'productName', 'unit', 'quantity', 'unitCost', 'totalRefund', 'reason', 'settlementType', 'invoiceNumber', 'notes', 'createdBy', 'createdByName', 'createdAt'])
        && isValidId(data.id)
        && data.returnNumber is string && data.returnNumber.size() >= 1 && data.returnNumber.size() <= 64
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160
        && data.unit in ['шт', 'кг', 'л', 'уп']
        && data.quantity is number && data.quantity > 0
        && data.unitCost is number && data.unitCost >= 0
        && data.totalRefund is number && data.totalRefund >= 0
        && data.reason in ['defect', 'expiring', 'wrong_delivery', 'overstock']
        && data.settlementType in ['offset_debt', 'cash_refund', 'pending_credit']
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    // --- Collection Rules ---

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && (
          isOwner()
          || incoming().role == 'customer'
          || (
            exists(/databases/$(database)/documents/staff_invites/$(incoming().email))
            && get(/databases/$(database)/documents/staff_invites/$(incoming().email)).data.active == true
            && incoming().role == get(/databases/$(database)/documents/staff_invites/$(incoming().email)).data.role
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isOwner()
          || (
            request.auth.uid == userId
            && incoming().role == existing().role
            && incoming().active == existing().active
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'twoFactorEnabled', 'twoFactorSecret', 'updatedAt'])
          )
        );
      allow delete: if isOwner() && isValidId(userId);
    }

    match /staff_invites/{inviteId} {
      allow get: if isVerifiedUser() && (isOwner() || request.auth.token.email == inviteId);
      allow list: if isOwner();
      allow create, update: if isOwner() && isValidStaffInvite(incoming());
      allow delete: if isOwner();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming()) && (
        isAdmin()
        || (
          isCashier()
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && incoming().retailPrice == existing().retailPrice
          && incoming().costPrice == existing().costPrice
          && incoming().name == existing().name
        )
        || (
          isVerifiedUser()
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && incoming().stock <= existing().stock
          && incoming().retailPrice == existing().retailPrice
          && incoming().costPrice == existing().costPrice
          && incoming().name == existing().name
        )
      );
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /sales/{saleId} {
      allow get: if isOwner() && isValidId(saleId);
      allow list: if isOwner();
      allow create: if (isCashier() || isVerifiedUser())
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().cashierId == request.auth.uid;
      allow update, delete: if false;
    }

    match /shifts/{shiftId} {
      allow get: if isSignedIn() && isValidId(shiftId) && (isOwner() || existing().cashierId == request.auth.uid);
      allow list: if isSignedIn() && (isOwner() || resource.data.cashierId == request.auth.uid);
      allow create: if isCashier()
        && isValidId(shiftId)
        && isValidShift(incoming())
        && incoming().cashierId == request.auth.uid;
      allow update: if isCashier()
        && isValidId(shiftId)
        && isValidShift(incoming())
        && incoming().cashierId == existing().cashierId
        && incoming().openedAt == existing().openedAt
        && (isOwner() || existing().cashierId == request.auth.uid);
      allow delete: if false;
    }

    match /write_offs/{writeOffId} {
      allow get: if isAdmin() && isValidId(writeOffId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(writeOffId)
        && isValidWriteOff(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update, delete: if isOwner() && isValidId(writeOffId);
    }

    match /invoices/{invoiceId} {
      allow get: if isAdmin() && isValidId(invoiceId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update, delete: if isOwner() && isValidId(invoiceId);
    }

    match /inventories/{inventoryId} {
      allow get: if isAdmin() && isValidId(inventoryId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(inventoryId)
        && isValidInventoryAudit(incoming())
        && incoming().performedBy == request.auth.uid;
      allow update, delete: if isOwner() && isValidId(inventoryId);
    }

    match /purchase_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (isAdmin() || existing().requesterId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.requesterId == request.auth.uid);
      allow create: if isRequester()
        && isValidId(requestId)
        && isValidPurchaseRequest(incoming())
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'new';
      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidPurchaseRequest(incoming())
        && incoming().requesterId == existing().requesterId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().requesterId == request.auth.uid
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['unreadForRequester', 'comment', 'updatedAt'])
          )
        );
      allow delete: if isOwner() && isValidId(requestId);
    }

    match /expenses/{expenseId} {
      allow get: if isAdmin() && isValidId(expenseId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update, delete: if isOwner() && isValidId(expenseId);
    }

    match /supplier_payments/{paymentId} {
      allow get: if isAdmin() && isValidId(paymentId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(paymentId)
        && isValidSupplierPayment(incoming())
        && incoming().createdBy == request.auth.uid;
      allow update: if isOwner()
        && isValidId(paymentId)
        && isValidSupplierPayment(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner() && isValidId(paymentId);
    }

    match /supplier_returns/{returnId} {
      allow get: if isAdmin() && isValidId(returnId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(returnId)
        && isValidSupplierReturn(incoming())
        && incoming().createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isAdmin()
        && isValidId(returnId)
        && isValidSupplierReturn(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          isOwner()
          || incoming().diff(existing()).affectedKeys().hasOnly(['settlementType', 'notes'])
        );
      allow delete: if isOwner() && isValidId(returnId);
    }

    match /security_logs/{logId} {
      allow get: if isOwner() && isValidId(logId);
      allow list: if isOwner();
      allow create: if isStaff()
        && isValidId(logId)
        && isValidSecurityLog(incoming())
        && incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /online_orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (isAdmin() || existing().customerId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOnlineOrder(incoming())
        && incoming().customerId == request.auth.uid
        && incoming().orderStatus == 'new'
        && (incoming().paymentMethod != 'qr_online' || incoming().paymentStatus == 'awaiting_verification')
        && (incoming().paymentMethod != 'cash_on_delivery' || incoming().paymentStatus == 'pending')
        && (incoming().paymentMethod != 'card_online' || incoming().paymentStatus == 'paid')
        && !('paymentVerifiedBy' in incoming())
        && !('paymentVerifiedAt' in incoming());
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOnlineOrder(incoming())
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner() && isValidId(orderId);
    }

    match /store_settings/{settingId} {
      allow get: if isValidId(settingId) && (
        settingId == 'public_store'
        || (settingId == 'pos_security' && isStaff())
        || isOwner()
      );
      allow list: if isOwner();
      allow create, update: if isOwner()
        && isValidId(settingId)
        && (
          (settingId == 'public_store' && isValidPublicStoreSettings(incoming()))
          || (settingId == 'pos_security' && isValidPosSecuritySettings(incoming()))
        );
      allow delete: if false;
    }
  }
}
